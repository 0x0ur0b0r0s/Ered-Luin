{
  "name": "ered-luin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:contracts && pnpm test:nansen && pnpm test:api && pnpm test:dashboard && pnpm test:typesafe && pnpm test:d2c && pnpm test:d2h && pnpm test:d2k && pnpm test:d2l && pnpm test:d2u",
    "test:contracts": "vitest run packages/contracts/src",
    "test:nansen": "pnpm --filter @ered-luin/nansen test",
    "test:api": "pnpm --filter @ered-luin/api test",
    "test:dashboard": "pnpm --filter @ered-luin/dashboard test",
    "test:typesafe": "vitest run tools/typesafe/shadow.test.mjs",
    "d2c:preflight": "node tools/d2c/preflight.mjs",
    "d2c:collect": "node tools/d2c/manual-collect.mjs",
    "d2h:collect": "node tools/d2h/collect.mjs",
    "d2k:collect": "node tools/d2k/run-token-diagnostic.mjs",
    "d2u:diagnostic": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2u/run-usdc-diagnostic.ps1",
    "d2u:diagnostic:dispatch": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2u/run-usdc-diagnostic.ps1 -Dispatch",
    "d2u:raw-attribution": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2u/run-raw-response-attribution.ps1",
    "d2u:raw-attribution:dispatch": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2u/run-raw-response-attribution.ps1 -Dispatch",
    "d2u:raw-attribution:replay": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2u/run-raw-response-attribution.ps1 -Replay",
    "d2u:readiness": "node tools/d2u/readiness-check.mjs",
    "d2v:diagnostic": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2v/run-diagnostic.ps1",
    "d2v:diagnostic:dispatch": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2v/run-diagnostic.ps1 -Dispatch",
    "d2v:refresh": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2v/run-refresh.ps1",
    "d2v:refresh:dispatch": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/d2v/run-refresh.ps1 -Dispatch",
    "d2v:raw-replay": "node tools/d2v/replay-captured-response.mjs",
    "d2v:readiness": "node tools/d2u/readiness-check.mjs",
    "d2c:offline-smoke": "node tools/d2c/offline-start-smoke.mjs",
    "d2c:base-capability-probe": "node tools/d2c/base-capability-probe.mjs",
    "test:d2c": "vitest run tools/d2c",
    "test:d2h": "pnpm run build && vitest run tools/d2h",
    "test:d2k": "vitest run tools/d2k",
    "test:d2u": "pnpm run build && vitest run tools/d2u",
    "test:d2v": "pnpm run build && vitest run tools/d2v packages/nansen/src/client.test.ts packages/nansen/src/query-manager.test.ts packages/nansen/src/ledger.test.ts apps/api/src/d2.test.ts apps/dashboard/src/d2-panel.test.tsx tools/d2u/d2u.test.mjs --reporter=dot",
    "d2c:init-observation-store": "node tools/d2c/init-observation-store.mjs",
    "d2l:collect": "node tools/d2h/collect.mjs --profile weth-research-v1",
    "d2l:collect:v2": "node tools/d2h/collect.mjs --profile weth-research-v2",
    "d2l:monitor": "node tools/d2l/monitor.mjs",
    "test:d2l": "pnpm run build && vitest run tools/d2l",
    "d2l:retire-unused": "node tools/d2h/retire-unused-allocation.mjs",
    "deadline:history": "node tools/deadline/history-runner.mjs",
    "deadline:history:dpapi": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/deadline/run-history.ps1",
    "test:deadline": "pnpm run build && vitest run tools/deadline tools/d2h/allocation-retirement.test.mjs packages/nansen/src/client.test.ts packages/nansen/src/query-manager.test.ts --reporter=dot"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0"
  }
}
